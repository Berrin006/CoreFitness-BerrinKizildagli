@model IEnumerable<Domain.Aggregates.GymClasses.GymClass>

@{
    ViewData["Title"] = "Available Classes";
}

<section class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>

        @if (User.Identity!.IsAuthenticated && User.IsInRole("admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create New Class
            </a>
        }
    </div>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are currently no classes scheduled. Please check back later!
        </div>
    }
    else
    {
        <table class="table table-hover mt-4">
            <thead class="table-light">
                <tr>
                    <th>Class Name</th>
                    <th>Instructor</th>
                    <th>Date & Time</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Instructor</td>
                        <td>@item.StartTime.ToString("f")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">

                                @if (User.Identity!.IsAuthenticated)
                                {
                                    <form asp-controller="GymClasses" asp-action="Book" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-primary btn-sm">Book</button>
                                    </form>

                                    <form asp-controller="GymClasses" asp-action="Unbook" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Unbook</button>
                                    </form>
                                }

                                @if (User.IsInRole("admin"))
                                {
                                    <form asp-controller="GymClasses" asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this class permanently?');">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>