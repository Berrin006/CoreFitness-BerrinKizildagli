@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@using Presentation.WebApp.Models.Account
@model SetPasswordViewModel

@{
    ViewData["Title"] = "Set Your Password";
}

<section class="login-section-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Set Your Password</h1>
            <p>
                Set a password to protect your account. Your password must be at least 6 characters long.
            </p>
        </div>

        <form asp-action="SetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="auth-input"/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="Password">New Password</label>
                <input asp-for="Password" type="password" class="auth-input" placeholder="Enter Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-terms">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <input asp-for="AcceptTerms" type="checkbox" id="terms" />
                    <label for="terms" style="margin: 0;">Accept user terms and conditions</label>
                </div>
                <span asp-validation-for="AcceptTerms" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn-primary">
                Continue <i class="fa-solid fa-chevron-right" style="font-size: 0.8rem;"></i>
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}