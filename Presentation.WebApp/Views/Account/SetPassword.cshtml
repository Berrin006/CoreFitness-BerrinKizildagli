@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@using Presentation.WebApp.Models.Account
@model SetPasswordViewModel

@{
    ViewData["Title"] = "Set Your Password";
}

<section class="login-section-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Set Your Password</h1>
            <p>
                Set a strong password to protect your account. For security reasons, your password must be at least 8 characters long and include uppercase and lowercase letters, numbers, and special characters.
            </p>
        </div>

        <form asp-action="SetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="auth-input" placeholder="username@domain.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="auth-input" placeholder="Enter Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn-primary">
                Continue <i class="fa-solid fa-chevron-right" style="font-size: 0.8rem;"></i>
            </button>

            <div class="auth-terms">
                <input type="checkbox" id="terms" required>
                <label for="terms">Accept user terms and conditions</label>
            </div>
        </form>
    </div>
</section>