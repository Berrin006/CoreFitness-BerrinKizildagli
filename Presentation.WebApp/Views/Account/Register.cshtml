@model RegisterViewModel
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Register";
}

<section class="login-section-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Become a Member</h1>
            <p>Sign up to continue your fitness journey with full access to your customized program, training history, and progress tracking. Stay consistent, monitor your development, and keep moving forward with the structure and support built into your account.</p>
        </div>

        <div class="social-icons-container">
            <div class="social-icons-row">
                <button type="button" class="social-icon-btn social-icon-dummy">
                    <i class="fa-brands fa-google"></i>
                </button>
                <button type="button" class="social-icon-btn social-icon-dummy">
                    <i class="fa-brands fa-facebook-f"></i>
                </button>

                <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="github-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" name="provider" value="GitHub" class="social-icon-btn github-active-btn" title="Logga in med GitHub">
                        <i class="fa-brands fa-github"></i>
                    </button>
                </form>
            </div>
        </div>

        <div class="auth-divider">
            <span>OR CONTINUE WITH</span>
        </div>

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-form-group">
                <label asp-for="Email">Email Address *</label>
                <input asp-for="Email" class="auth-input" placeholder="Enter Email Address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="Password">Password *</label>
                <input asp-for="Password" type="password" class="auth-input" placeholder="********" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="ConfirmPassword">Confirm Password *</label>
                <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="********" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn-primary">
                Continue <i class="fa-solid fa-chevron-right" style="font-size: 0.8rem;"></i>
            </button>

            <p class="auth-footer" style="margin-top: 20px; font-size: 12px; color: #636672;">
                By clicking "Continue", we will send a verification code to your email address.
            </p>

            <p class="auth-footer">
                Already a member? <a href="/Account/Login">Sign in here</a>
            </p>
        </form>
    </div>
</section>