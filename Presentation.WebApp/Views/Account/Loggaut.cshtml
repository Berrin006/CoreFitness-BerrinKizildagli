@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@{
    ViewData["Title"] = "My Profile";
    var user = await UserManager.GetUserAsync(User);
}

<section class="profile-section container mt-5">
    <div class="profile-card card shadow-sm p-4">
        <div class="card-body">
            <h2 class="card-title mb-4">Welcome, @(user?.UserName ?? "Member")!</h2>

            <div class="user-info">
                <p><strong>Email:</strong> @user?.Email</p>
                <p><strong>Member ID:</strong> @user?.Id</p>
            </div>

            <div class="actions mt-4 d-flex gap-3">
                <a href="/" class="btn btn-secondary">Back to Home</a>

                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Logout</button>
                </form>
            </div>
        </div>
    </div>
</section>