@model Domain.Aggregates.Memberships.Membership

<section class="container mt-5">
    <h1>Our Memberships</h1>

    @if (Model != null && Model.IsActive)
    {
        <div class="alert alert-info">
            <h3>Your current membership</h3>
            <p>Plan: <strong>@Model.PlanName</strong></p>
            <p>Start Date: @Model.StartDate.ToShortDateString()</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Monthly Pass</h5>
                        <p class="card-text">399 kr / month</p>
                        <form asp-action="Subscribe" method="post">
                            <input type="hidden" name="planName" value="Monthly" />
                            <button type="submit" class="primary-button">Select Monthly</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-center border-primary">
                    <div class="card-body">
                        <h5 class="card-title text-primary">Annual Pass</h5>
                        <p class="card-text">3499 kr / year</p>
                        <form asp-action="Subscribe" method="post">
                            <input type="hidden" name="planName" value="Annual" />
                            <button type="submit" class="primary-button">Select Annual</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</section>