@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<footer class="container mt-5">
    <div class="footer-dark-panel">
        <div class="footer-content">

            <div class="footer-top">
                <div class="footer-logo">
                    <img src="~/images/logotype.png" alt="CoreFitness" style="height: 40px;" />
                </div>
                <h2>Empowering Your Fitness Journey with Expert Training and Lasting Results.</h2>
            </div>

            <div class="footer-grid">

                <div class="footer-column">
                    <h4>Our Location</h4>
                    <p>
                        Our supportive and knowledgeable trainers work
                        with member to provide encourangement.
                    </p>
                    <div class="footer-location-img">
						<img src="~/images/footer-location-map-image.png" alt="gym location"/>
                    </div>
                    <div class="location-info mt-3">
                        <span>2nd Floor, Wellness Center, Drottninggatan 118, Stockholm</span>
                    </div>
                </div>

                <div class="footer-column">
                    <h4>Working Hours</h4>
                    <p>Mon - Fri: 06:00 - 18:00</p>
                    <p>Saturday: 10:00 - 18:00</p>
                </div>

                <div class="footer-column">
                    <h4>Opening Hours</h4>
                    <p>Mon - Sun: 04:00 - 23:00</p>
                </div>

            </div>
        </div>
    </div>

    
</footer>