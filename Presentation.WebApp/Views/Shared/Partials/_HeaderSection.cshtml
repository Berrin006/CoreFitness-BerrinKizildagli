@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<section class="mobile-header-section">
    <div class="logo">
        <a class="logotype-link" href="/">
            <img src="~/images/logotype-text.png" alt="CoreFitness Group">
        </a>
    </div>

    <div class="mobile-menu">
        @if (SignInManager.IsSignedIn(User))
        {
            <a class="account-button" asp-controller="Account" asp-action="Index">
                <i class="fa-regular fa-user"></i>
            </a>
        }
        <partial name="Partials/MenuNavigation/_Mobile" />
    </div>
</section>

<section class="header-section">
    <div class="logo">
        <a class="logotype-link" href="/">
            <img src="~/images/logotype.png" alt="CoreFitness Group">
        </a>
    </div>

    <partial name="Partials/MenuNavigation/_Desktop" />

    <nav class="account-menu menu">
        @if (SignInManager.IsSignedIn(User))
        {
            <a class="primary-button offset" asp-controller="Account" asp-action="Loggaut">My Account</a>

            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                <button type="submit" class="signup menu-item" style="border:none; background:none; cursor:pointer;">
                    Logout (@User.Identity?.Name)
                </button>
            </form>
        }
        else
        {
            <a class="signup menu-item" asp-controller="Auth" asp-action="SignUp">Become Member</a>
            <a class="primary-button offset" asp-controller="Auth" asp-action="SignIn">Login</a>
        }
    </nav>
</section>