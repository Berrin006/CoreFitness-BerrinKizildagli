@{
    ViewData["Title"] = "Page Not Found";
}
@using Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<section class="error-404-section">
    <div class="container text-center">
        <div class="error-content">
            <img src="~/images/404-error-image.png" alt="404 Error - Page Not Found" class="error-img" />
            <h1>Oops! Page not found.</h1>
            <p>It looks like you've lifted a bit too heavy and ended up in the wrong place.</p>
            <a asp-controller="Home" asp-action="Index" class="btn">Back to home</a>
        </div>
    </div>
</section>

<div class="page__home">
    <div class="container">
        <partial name="Partials/Common/_FooterSection" />
    </div>
</div>